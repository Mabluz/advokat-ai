    "sync:reindex": "tsx src/sync.ts --reindex",
    "dommer": "tsx src/dommer/sync.ts",
    "export": "tsx src/transfer.ts export",
    "import": "tsx src/transfer.ts import",
    "mcp": "tsx src/mcp-server.ts",
    "search": "tsx src/cli-search.ts",
    "test": "tsx --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@qdrant/js-client-rest": "^1.19.0",
